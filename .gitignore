# OS / editors
.DS_Store
.vscode/
.idea/

# Dependencies (the app has none; only test tooling would add them)
node_modules/

# Build output (tools/build-site.mjs; GitHub Actions builds its own)
_site/

# Test output and screenshots (regenerated by npm run test:browser)
docs/screenshots/
test-results/
coverage/
*.log

# Headless Chrome profiles and temp folders from the browser tests and icon build
wt-e2e-*/
vane-subpath-*/
vane-icons-*/
*-prof/
.chrome-profile*/

# Your data: exported backups and CSVs never belong in the repo
workout-backup-*.json
workout-sets-*.csv
vane-backup-*.json
*.backup.json

# Test fixtures with personal data (the public free-exercise-db schema stays)
tests/fixtures/personal/
tests/fixtures/*.private.*

# Local secrets and settings
.env
.env.*
.claude/settings.local.json
